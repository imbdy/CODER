{
  "name": "artisan",
  "version": "0.1.0",
  "private": true,
  "description": "Artisan - a creative frontend design & engineering agent: discuss > agree > build > render > critique > iterate > test",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "artisan": "./bin/artisan.mjs"
  },
  "exports": {
    ".": "./src/runtime/session.mjs"
  },
  "scripts": {
    "artisan": "node ./bin/artisan.mjs",
    "chat": "node ./bin/artisan.mjs chat",
    "test": "node --test tests/unit/*.test.mjs",
    "test:agent": "node --test tests/agent/design-agent.test.mjs",
    "test:all": "node --test tests/unit/*.test.mjs tests/agent/*.test.mjs",
    "e2e": "node ./scripts/e2e.mjs",
    "serve": "node ./scripts/serve.mjs",
    "doctor": "node ./bin/artisan.mjs doctor",
    "skills": "node ./bin/artisan.mjs skills list",
    "test:flow": "node --test tests/agent/conversation-flow.test.mjs"
  },
  "keywords": [
    "agent",
    "frontend",
    "design",
    "autonomous"
  ],
  "license": "MIT"
}
