# Copy to .env and fill in. .env is gitignored; this file is not.
# A real exported shell variable always overrides what is set here.

# --- Groq -------------------------------------------------------------------
# A gsk_ key selects Groq's base URL automatically.
# ARTISAN_API_KEY=gsk_...
# ARTISAN_MODEL=groq/compound

# --- Any other OpenAI-compatible endpoint (opencode, OpenRouter, vLLM, …) ----
# MODEL_API_KEY=sk-...
# MODEL_NAME=muse-spark-1.2-contributor-free
# MODEL_BASE_URL=https://opencode.ai/zen/v1

# low | medium | high. Reasoning models default to low so a small token window
# buys an answer rather than deliberation.
# REASONING_EFFORT=medium

# --- Local model ------------------------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# ARTISAN_OLLAMA_MODEL=qwen2.5-coder:7b

# --- Optional ---------------------------------------------------------------
# ARTISAN_PROVIDERS=openai-compatible,ollama,deterministic
# ARTISAN_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
